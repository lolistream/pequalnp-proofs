private theorem sorted7 : ∀ d : K, d ≤ 7 → ∀ c : K, c ≤ d → ∀ b : K, b ≤ c → ∀ a : K, a ≤ b →
    coversType a b c d 7 = true := by decide

private theorem sorted_types (e d c b a : K) (h₁ : a ≤ b) (h₂ : b ≤ c) (h₃ : c ≤ d) (h₄ : d ≤ e) :
    coversType a b c d e = true := by
  fin_cases e
  · exact sorted0 d h₄ c h₃ b h₂ a h₁
  · exact sorted1 d h₄ c h₃ b h₂ a h₁
  · exact sorted2 d h₄ c h₃ b h₂ a h₁
  · exact sorted3 d h₄ c h₃ b h₂ a h₁
  · exact sorted4 d h₄ c h₃ b h₂ a h₁
  · exact sorted5 d h₄ c h₃ b h₂ a h₁
  · exact sorted6 d h₄ c h₃ b h₂ a h₁
  · exact sorted7 d h₄ c h₃ b h₂ a h₁

private theorem tuple_eta (f : C → K) : tuple (f 0) (f 1) (f 2) (f 3) (f 4) = f := by
  funext j; fin_cases j <;> rfl

private theorem lookup_mem (xs : Array Nat) (i : Nat) (h : i < xs.size) : xs[i]! ∈ xs.toList := by
  rw [getElem!_pos xs i h]
  exact Array.getElem_mem_toList h

set_option maxRecDepth 12000 in
/-- Every Boolean 3-by-5 adjacency table with arbitrary labels is a row and column
relabeling of a mask in the finite representative list. This asserts coverage, not optimality. -/
theorem covers_all (A : Fin 3 → Fin 5 → Bool) :
    ∃ m ∈ masks.toList, ∃ r : Equiv.Perm (Fin 3), ∃ p : Equiv.Perm (Fin 5),
      ∀ i j, A i j = adjacency m (r i) (p j) := by
  let f : C → K := fun j => pack (A 0 j) (A 1 j) (A 2 j)
  let s := Tuple.sort f
  let v : C → K := f ∘ s
  have hv : Monotone v := Tuple.monotone_sort f
  let z := table[index (v 0) (v 1) (v 2) (v 3) (v 4)]!
  let m := masks[z % 190]!
  let k := Fin.ofNat 6 (z / 190)
  let r := rowPerm k
  let p := colPerm (Fin.ofNat 120 (z / 1140))
  have h := sorted_types (v 4) (v 3) (v 2) (v 1) (v 0)
    (hv (by decide : (0:C) ≤ 1)) (hv (by decide : (1:C) ≤ 2))
    (hv (by decide : (2:C) ≤ 3)) (hv (by decide : (3:C) ≤ 4))
  simp only [coversType, decide_eq_true_eq] at h
  rw [tuple_eta v] at h
  have hm : z % 190 < masks.size := by rw [masks_size]; exact Nat.mod_lt _ (by decide)
  have hmem : m ∈ masks.toList := lookup_mem masks (z % 190) hm
  refine ⟨m, hmem, r, s.symm.trans p, ?_⟩
  intro i j
  have hb : A i j = (f j).val.testBit i.val := by
    change A i j = (pack (A 0 j) (A 1 j) (A 2 j)).val.testBit i.val
    rw [pack_bit]; fin_cases i <;> rfl
  have hc := h (s.symm j)
  change f (s (s.symm j)) = rowType k (col m (p (s.symm j))) at hc
  rw [Equiv.apply_symm_apply] at hc
  rw [hb, hc, rowType_bit, col_bit]
  rfl

end PEqualNP.Rep35Orbit
