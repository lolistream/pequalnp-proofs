private abbrev R := Fin 3
private abbrev C := Fin 5
private abbrev K := Fin 8

/-- Row-major, little-endian encoding of the adjacency matrix. -/
def adjacency (mask : Nat) (i : Fin 3) (j : Fin 5) : Bool :=
  mask.testBit (5*i.val + j.val)

private def pack (a b c : Bool) : K :=
  Fin.ofNat 8 ((if a then 1 else 0) + (if b then 2 else 0) + (if c then 4 else 0))

private theorem pack_bit (a b c : Bool) (i : R) :
    (pack a b c).val.testBit i.val = (![a,b,c] : R → Bool) i := by
  revert a b c i; decide

private def col (m : Nat) (j : C) : K := pack (adjacency m 0 j) (adjacency m 1 j) (adjacency m 2 j)

private theorem col_bit (m : Nat) (j : C) (i : R) :
    (col m j).val.testBit i.val = adjacency m i j := by
  rw [col, pack_bit]; fin_cases i <;> rfl

private def tuple (a b c d e : K) : C → K := ![a,b,c,d,e]

private def index (a b c d e : K) : Nat :=
  let C2 := fun n : Nat => n*(n-1)/2
  let C3 := fun n : Nat => n*(n-1)*(n-2)/6
  let C4 := fun n : Nat => n*(n-1)*(n-2)*(n-3)/24
  let C5 := fun n : Nat => n*(n-1)*(n-2)*(n-3)*(n-4)/120
  a.val + C2 (b.val+1) + C3 (c.val+2) + C4 (d.val+3) + C5 (e.val+4)

