private def rp (i : Fin 6) : R → R := perm3[i.val]!
private def cp (i : Fin 120) : C → C := perm5[i.val]!

private theorem rp_bij : ∀ i : Fin 6, Function.Bijective (rp i) := by decide
set_option maxRecDepth 10000 in
private theorem cp_bij : ∀ i : Fin 120, Function.Bijective (cp i) := by decide

private noncomputable def rowPerm (i : Fin 6) : Equiv.Perm R := Equiv.ofBijective (rp i) (rp_bij i)
private noncomputable def colPerm (i : Fin 120) : Equiv.Perm C := Equiv.ofBijective (cp i) (cp_bij i)
private def rowType (k : Fin 6) (x : K) : K := rowTypeTable[8*k.val+x.val]!
private theorem rowType_bit : ∀ (k : Fin 6) (x : K) (i : R),
    (rowType k x).val.testBit i.val = x.val.testBit (rp k i).val := by decide

private def coversType (a b c d e : K) : Bool :=
  let z := table[index a b c d e]!
  let m := masks[z % 190]!
  let k := Fin.ofNat 6 (z / 190)
  let p := cp (Fin.ofNat 120 (z / 1140))
  decide (∀ j : C, tuple a b c d e j = rowType k (col m (p j)))

set_option maxRecDepth 10000 in
private theorem masks_size : masks.size = 190 := by decide

