private def dig3 (k : Fin 6) : Fin 3 → Fin 3 := digit (tab3[k.val]!)
private theorem rec3 : ∀ k : Fin 6, encode3 (dig3 k) = tab3[k.val]! := by decide
private theorem inc3 : ∀ k : Fin 5, tab3[k.castSucc.val]! < tab3[k.succ.val]! := by decide
private theorem bij3 : ∀ k : Fin 6, Function.Bijective (dig3 k) := by decide
private noncomputable def eq3 (k : Fin 6) : Equiv.Perm (Fin 3) :=
  Equiv.ofBijective (dig3 k) (bij3 k)
private theorem inj3 : Function.Injective eq3 := by
  intro i j h
  have hm : StrictMono (fun k : Fin 6 => tab3[k.val]!) := Fin.strictMono_iff_lt_succ.mpr inc3
  apply hm.injective
  change tab3[i.val]! = tab3[j.val]!
  rw [← rec3 i, ← rec3 j]
  exact congrArg encode3 (congrArg (fun p : Equiv.Perm (Fin 3) => (p : Fin 3 → Fin 3)) h)

