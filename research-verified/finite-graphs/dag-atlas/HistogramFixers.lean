/-- (representative mask, minimum gate budget, numerical upper bound on relabelings).
`weights_bound` certifies only the third coordinate; it does not assume the budget is optimal. -/
def weights : List (Nat × Nat × Nat) :=
  (0, 0, 1) :: (32767, 1, 1) :: rows.map Evidence.t

/-- Stabilizer certificates upper-bound the orbit of every listed mask. -/
theorem weights_bound : ∀ t ∈ weights,
    (orbit (fun i j => t.1.testBit (5*i.val+j.val))).card ≤ t.2.2 := by
  intro t ht
  simp only [weights, List.mem_cons, List.mem_map] at ht
  rcases ht with rfl | rfl | ⟨e, he, rfl⟩
  · exact bound0
  · exact bound1
  · exact sound e (List.all_eq_true.mp rows_ok e he)

