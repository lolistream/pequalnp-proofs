namespace PEqualNP.Rep35Histogram

private abbrev Row := Fin 3
private abbrev Col := Fin 5

private def digit {n : Nat} [NeZero n] (p : Nat) (i : Fin n) : Fin n :=
  Fin.ofNat n (p / n ^ i.val)

private def getRow (m : Nat) (i : Row) : Nat := m / 2 ^ (5*i.val) % 32

private def permRow (p r : Nat) : Nat :=
  (if r.testBit (digit p (0:Col)).val then 1 else 0) +
  (if r.testBit (digit p (1:Col)).val then 2 else 0) +
  (if r.testBit (digit p (2:Col)).val then 4 else 0) +
  (if r.testBit (digit p (3:Col)).val then 8 else 0) +
  (if r.testBit (digit p (4:Col)).val then 16 else 0)

private def encode3 (f : Row → Row) : Nat :=
  (f 0).val + 3*(f 1).val + 9*(f 2).val
private def encode5 (f : Col → Col) : Nat :=
  (f 0).val + 5*(f 1).val + 25*(f 2).val + 125*(f 3).val + 625*(f 4).val

private theorem bit_pack (a b c d e : Bool) (i : Col) :
    ((if a then 1 else 0) + (if b then 2 else 0) + (if c then 4 else 0) +
      (if d then 8 else 0) + (if e then 16 else 0) : Nat).testBit i.val =
    (![a,b,c,d,e] : Col → Bool) i := by
  revert a b c d e i; decide

private theorem permRow_bit (p r : Nat) (j : Col) :
    (permRow p r).testBit j.val = r.testBit (digit p j).val := by
  rw [permRow, bit_pack]; fin_cases j <;> rfl

private theorem getRow_bit (m : Nat) (i : Row) (j : Col) :
    (getRow m i).testBit j.val = m.testBit (5*i.val+j.val) := by
  rw [getRow, show (32 : Nat) = 2 ^ 5 by decide, Nat.testBit_mod_two_pow,
    Nat.testBit_div_two_pow]
  simp [j.isLt, Nat.add_comm]

private def tab3 : Array Nat := #[
  5, 7, 11, 15, 19, 21
]

