private def dig5 (k : Fin 120) : Fin 5 → Fin 5 := digit (tab5[k.val]!)
private theorem rec5 : ∀ k : Fin 120, encode5 (dig5 k) = tab5[k.val]! := by decide
private theorem inc5 : ∀ k : Fin 119, tab5[k.castSucc.val]! < tab5[k.succ.val]! := by decide
private theorem bij5 : ∀ k : Fin 120, Function.Bijective (dig5 k) := by decide
private noncomputable def eq5 (k : Fin 120) : Equiv.Perm (Fin 5) :=
  Equiv.ofBijective (dig5 k) (bij5 k)
private theorem inj5 : Function.Injective eq5 := by
  intro i j h
  have hm : StrictMono (fun k : Fin 120 => tab5[k.val]!) := Fin.strictMono_iff_lt_succ.mpr inc5
  apply hm.injective
  change tab5[i.val]! = tab5[j.val]!
  rw [← rec5 i, ← rec5 j]
  exact congrArg encode5 (congrArg (fun p : Equiv.Perm (Fin 5) => (p : Fin 5 → Fin 5)) h)

private noncomputable def iso (c : Fin 6 × Fin 120) : Sym := (eq3 c.1, eq5 c.2)
private theorem iso_inj : Function.Injective iso := by
  intro x y h
  exact Prod.ext (inj3 (congrArg Prod.fst h)) (inj5 (congrArg Prod.snd h))

private abbrev Weight := Nat × Nat × Nat
private abbrev Code := Fin 6 × Fin 120
private def adj (m : Nat) : Matrix := fun i j => m.testBit (5*i.val+j.val)
private def fixes (m : Nat) (c : Code) : Bool :=
  let p := tab5[c.2.val]!
  decide (∀ i : Row, permRow p (getRow m (dig3 c.1 i)) = getRow m i)

private theorem fixes_sound (m : Nat) (c : Code) (h : fixes m c = true) :
    move (iso c) (adj m) = adj m := by
  simp only [fixes, decide_eq_true_eq] at h
  funext i j
  have hh := congrArg (fun x : Nat => x.testBit j.val) (h i)
  simp only [permRow_bit, getRow_bit] at hh
  exact hh

private structure Evidence where
  t : Weight
  codes : List Code

private def well (e : Evidence) : Bool :=
  decide (e.codes.Nodup ∧ 0 < e.codes.length ∧ e.t.2.2 * e.codes.length = 720) &&
    e.codes.all (fixes e.t.1)

private theorem sound (e : Evidence) (h : well e = true) :
    (orbit (adj e.t.1)).card ≤ e.t.2.2 := by
  simp only [well, Bool.and_eq_true, decide_eq_true_eq] at h
  let s := e.codes.toFinset
  have hc : s.card = e.codes.length := List.toFinset_card_of_nodup h.1.1
  apply orbit_bound (adj e.t.1) s iso iso_inj
  · intro i hi
    exact fixes_sound _ i (List.all_eq_true.mp h.2 i (List.mem_toFinset.mp hi))
  · simpa [hc] using h.1.2.1
  · simpa [hc] using h.1.2.2

private theorem const_bound (b : Bool) : (orbit (fun _ _ => b)).card ≤ 1 := by
  classical
  have ht : orbit (fun _ _ => b) ⊆ ({fun _ _ => b} : Finset Matrix) := by
    intro x hx
    obtain ⟨g, _, rfl⟩ := Finset.mem_image.mp hx
    exact Finset.mem_singleton.mpr rfl
  simpa using Finset.card_le_card ht

private theorem bound0 : (orbit (adj 0)).card ≤ 1 := by
  have h : adj 0 = fun _ _ => false := by funext i j; revert i j; decide
  rw [h]; exact const_bound false
private theorem bound1 : (orbit (adj 32767)).card ≤ 1 := by
  have h : adj 32767 = fun _ _ => true := by funext i j; revert i j; decide
  rw [h]; exact const_bound true

