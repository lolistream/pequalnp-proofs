import Mathlib
import PEqualNP.Defs

namespace PEqualNP.Rep35Upper

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.Represents

structure Entry where
  mask : Nat
  budget : Nat
  gates : List Gate
  output : Nat

def Entry.circuit (e : Entry) : Circuit := ⟨e.gates, e.output⟩

def adjacency (mask : Nat) (i : Fin 3) (j : Fin 5) : Bool :=
  mask.testBit (5 * i.val + j.val)

private def opOK (g : Gate) : Bool :=
  match g.op with
  | .and | .or => decide (g.inputs.length ≤ 2)
  | _ => false

private def check (e : Entry) : Bool :=
  e.gates.all opOK && decide (e.circuit.size = e.budget) &&
    decide (Represents (adjacency e.mask) e.circuit)

private theorem check_sound (e : Entry) (h : check e = true) :
    Monotone2 e.circuit ∧ e.circuit.size = e.budget ∧
      Represents (adjacency e.mask) e.circuit := by
  have hf := h
  simp only [check, Bool.and_eq_true, decide_eq_true_eq] at hf
  refine ⟨?_, hf.1.2, hf.2⟩
  intro g hg
  have hp := (List.all_eq_true.mp hf.1.1) g hg
  rcases g with ⟨op, ins⟩
  cases op <;> simp_all [opOK]

private abbrev a (x y : Nat) : Gate := ⟨.and, [x, y]⟩
private abbrev o (x y : Nat) : Gate := ⟨.or, [x, y]⟩

