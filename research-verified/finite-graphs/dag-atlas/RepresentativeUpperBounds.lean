]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 10000000 in
private theorem entriesChecked : entries.all check = true := by decide

set_option maxRecDepth 10000 in
theorem entries_length : entries.length = 190 := by decide

/-- The table contains one witness for each listed mask, with the recorded number of gates.
This is an upper-bound statement, not a proof of optimality or of relabeling invariance. -/
theorem entries_certified (e : Entry) (he : e ∈ entries) :
    Monotone2 e.circuit ∧ e.circuit.size = e.budget ∧
      Represents (adjacency e.mask) e.circuit :=
  check_sound e ((List.all_eq_true.mp entriesChecked) e he)

theorem entries_upper (e : Entry) (he : e ∈ entries) :
    RepSizeAtMost (adjacency e.mask) e.budget := by
  obtain ⟨hop, hsize, hrep⟩ := entries_certified e he
  exact ⟨e.circuit, hop, hsize.le, hrep⟩

end PEqualNP.Rep35Upper
